{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bull Arrives",
  "version": "1.2.0",
  "identifier": "com.chinesecanfly-wxy.quant-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bull Arrives - 免费实时A股看盘",
        "width": 1000,
        "height": 680,
        "visible": false,
        "center": true,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "ticker",
        "title": "Bull Arrives Ticker",
        "url": "ticker.html",
        "width": 230,
        "height": 38,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "dragDropEnabled": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "pattern": {
        "use": "brownfield"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ChineseCanFly-wxy/bull-arrives/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4NjI5MDBDQzE3MzlENzUKUldSMW5YUEJESkJpdUxTeWdRc3JodjFRU2s1WWRBWWZIYU5CWlJ4OEs1RzlzQ2o4VnIwNHpkc3UK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
